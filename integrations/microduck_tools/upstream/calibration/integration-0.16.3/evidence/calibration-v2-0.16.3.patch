+impl Bus {
+    /// None means all original official motor coordinates, IMU mount and gyro scale.
+    pub fn load_calibration(&self) -> Result<Option<RobotCalibration>, String> {
+        if self.calibration_path.is_empty() {
+            return Ok(None);
+        }
+        let path = std::path::Path::new(&self.calibration_path);
+        if !path.is_absolute() {
+            return Err("bus.calibration_path must be absolute".into());
+        }
+        let raw = std::fs::read_to_string(path)
+            .map_err(|e| format!("reading {}: {e}", path.display()))?;
+        RobotCalibration::from_text(&raw).map(Some)
+    }
+}
