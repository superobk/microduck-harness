+/// A pure, reversible conversion between policy coordinates and XL330 radians.
+/// This changes no EEPROM registers. Default is exactly the official mapping.
+#[derive(Debug, Clone, Copy)]
+pub struct JointCalibration {
+    zero_rad: [f64; NUM_JOINTS],
+    direction: [i8; NUM_JOINTS],
+    enabled: bool,
+}
+
+impl Default for JointCalibration {
+    fn default() -> Self {
+        Self { zero_rad: [0.0; NUM_JOINTS], direction: [1; NUM_JOINTS], enabled: false }
+    }
+}
+impl JointCalibration {
+    pub fn new(zero_rad: [f64; NUM_JOINTS], direction: [i8; NUM_JOINTS]) -> Result<Self> {
+        for i in 0..NUM_JOINTS {
+            if !zero_rad[i].is_finite() || zero_rad[i].abs() > 0.35 {
+                return Err(IoError::Bus(format!("calibration joint {i}: bad zero offset")));
+            }
+            if direction[i] != 1 && direction[i] != -1 {
+                return Err(IoError::Bus(format!("calibration joint {i}: direction not ±1")));
+            }
+        }
+        Ok(Self { zero_rad, direction, enabled: true })
+    }
+    pub fn to_robot(&self, i: usize, raw_angle: f64) -> f64 {
+        f64::from(self.direction[i]) * (raw_angle - self.zero_rad[i])
+    }
+    pub fn to_motor(&self, i: usize, robot_angle: f64) -> Result<f64> {
+        let raw = self.zero_rad[i] + f64::from(self.direction[i]) * robot_angle;
+        // Only enable the extra bound check for an explicitly installed calibration.
+        // No calibration => exactly the original write path.
+        if self.enabled && (!raw.is_finite() || raw < -PI || raw > PI - 2.0 * PI / 4096.0) {
+            return Err(IoError::Bus(format!("calibrated target joint {i} outside XL330 single-turn range")));
+        }
+        Ok(raw)
+    }
+    pub fn to_robot_velocity(&self, i: usize, vel: f64) -> f64 {
+        f64::from(self.direction[i]) * vel
+    }
+}
