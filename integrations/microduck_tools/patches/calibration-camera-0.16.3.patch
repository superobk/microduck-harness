+#[derive(Debug, Clone, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct RobotCalibration {
+    pub schema: u32,
+    pub target_tag: String,
+    /// Zero-position correction in the existing official joint-angle coordinates.
+    pub joint_zero_rad: [f64; 15],
+    /// +1 means existing sign; -1 reverses both joint position and velocity.
+    pub joint_direction: [i8; 15],
+    /// Sensor-to-trunk quaternion, scalar first.
+    pub imu_mount_wxyz: [f64; 4],
+    /// The official daemon currently supports the raw gyro of its bus ID 200 only.
+    #[serde(default = "default_imu_module")]
+    pub imu_module: String,
+    /// Human-readable verified profile. This does not configure the IMU hardware.
+    #[serde(default = "default_gyro_profile")]
+    pub gyro_profile: String,
+    /// raw counts per 1 degree/second. rad/s = raw * PI / (180 * counts).
+    #[serde(default = "default_gyro_counts")]
+    pub gyro_raw_counts_per_dps: f64,
+}
+
+impl RobotCalibration {
+    pub fn from_text(text: &str) -> Result<Self, String> {
+        let cal: Self = toml::from_str(text).map_err(|e| format!("calibration TOML: {e}"))?;
+        if ![1, 2].contains(&cal.schema) {
+            return Err(format!("calibration schema {} unsupported; expected 1 or 2", cal.schema));
+        }
+        if cal.target_tag != "daemon-v0.16.3" {
+            return Err(format!("calibration built for {}, expected daemon-v0.16.3", cal.target_tag));
+        }
+        let q2: f64 = cal.imu_mount_wxyz.iter().map(|x| x * x).sum();
+        if !q2.is_finite() || (q2 - 1.0).abs() > 1e-4 {
+            return Err(format!("imu_mount_wxyz not a normalized finite quaternion: norm²={q2}"));
+        }
+        for (i, (&zero, &dir)) in cal.joint_zero_rad.iter().zip(&cal.joint_direction).enumerate() {
+            if !zero.is_finite() || zero.abs() > 0.35 {
+                return Err(format!("joint index {i}: zero correction must be within ±0.35rad"));
+            }
+            if dir != 1 && dir != -1 {
+                return Err(format!("joint index {i}: direction must be +1 or -1"));
+            }
+        }
+        if cal.imu_module != "bus_imu200" {
+            return Err(format!("unsupported IMU module {}: official robotd only reads bus ID200", cal.imu_module));
+        }
+        let c = cal.gyro_raw_counts_per_dps;
+        if !c.is_finite() || !(5.0..=300.0).contains(&c) {
+            return Err("gyro_raw_counts_per_dps must be finite, within 5..=300".into());
+        }
+        let expected = match cal.gyro_profile.as_str() {
+            "st_125dps" => Some(1.0 / 0.004375),
+            "st_250dps" => Some(1.0 / 0.00875),
+            "st_500dps" => Some(1.0 / 0.0175),
+            "st_1000dps" => Some(1.0 / 0.035),
+            "st_2000dps" => Some(1.0 / 0.070),
+            "st_4000dps" => Some(1.0 / 0.140),
+            "custom_raw_div_16_4" => Some(16.4),
+            "manual" => None,
+            other => return Err(format!("unknown gyro_profile {other}")),
+        };
+        if let Some(expected) = expected {
+            if (c - expected).abs() > 1e-5 {
+                return Err(format!("gyro_profile {} expects {} counts/dps, got {}", cal.gyro_profile, expected, c));
+            }
+        }
+        if cal.schema == 1 && (cal.gyro_profile != "st_500dps" || (c - default_gyro_counts()).abs() > 1e-5) {
+            return Err("legacy schema 1 cannot carry non-default gyro scaling; use schema 2".into());
+        }
+        Ok(cal)
+    }
+}
