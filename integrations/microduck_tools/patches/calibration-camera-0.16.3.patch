+    #[test]
+    fn inverse_mapping_and_velocity_sign() {
+        let mut zero = [0.0; NUM_JOINTS];
+        let mut dir = [1; NUM_JOINTS];
+        zero[3] = 0.08;
+        dir[3] = -1;
+        let c = JointCalibration::new(zero, dir).unwrap();
+        let robot = c.to_robot(3, 0.12);
+        assert!((robot + 0.04).abs() < 1e-12);
+        assert!((c.to_motor(3, robot).unwrap() - 0.12).abs() < 1e-12);
+        assert_eq!(c.to_robot_velocity(3, 2.0), -2.0);
+    }
