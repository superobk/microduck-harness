# Example only: the application does not auto-load .env files.
# Export selected variables in the process shell; keep actual .env out of git/archives.
HARNESS_MODE=demo
DECISION_MODE=demo
GLM_BASE_URL=http://127.0.0.1:8000/v1
GLM_MODEL=GLM5.3-Flash
GLM_API_KEY=
GLM_JSON_MODE=true
# Optional operator settings file. Existing saved settings take precedence over
# initial model environment defaults. Separate from robot/vision safety settings.
MODEL_CONFIG_FILE=data/model-settings.json
AGENTJEV_URL=http://127.0.0.1:8149
EXECUTOR_URL=http://127.0.0.1:8766
VISION_URL=http://127.0.0.1:8767
TOOLS_URL=http://127.0.0.1:8768
GATEWAY_TOKEN=
EXECUTOR_TOKEN=
VISION_TOKEN=
EXECUTOR_ALLOW_MOTION=0
EXECUTOR_ROBOTD_VERSION=auto
# Plugin-enabled native deployment; requires the matching patched daemons.
# duck-deploy generates explicit JSON values that take precedence over defaults.
EXECUTOR_REQUIRE_NATIVE_PLUGINS=1
NATIVE_CONFIG_PATH=/etc/robot/robotd.toml
CALIBRATION_RUNTIME_PATH=/run/robotd/calibration-effective.json
CAMERA_RUNTIME_PATH=/run/mediad/camera-effective.json
EXECUTOR_HOST=127.0.0.1
HARNESS_DB=data/harness.sqlite3

